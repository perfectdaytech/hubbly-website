# Public. Baked into the static site. Leave blank for preview mode:
# the form does not email anyone and does not save addresses.
# When set, the form POSTs to this MailerLite form action URL.
PUBLIC_MAILERLITE_FORM_ACTION=

# Existing cookieless analytics. Leave blank in development.
PUBLIC_POSTHOG_KEY=
PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com

# Server-side only. Never expose the API key in a PUBLIC_ variable.
# mock (default) reads WAITLIST_EXPORT_PATH or data/mock-subscribers.json.
# live calls MailerLite. Do not set live until the owner has created the account.
MAILERLITE_MODE=mock
MAILERLITE_API_KEY=
WAITLIST_EXPORT_PATH=
