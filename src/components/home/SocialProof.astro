---
import Section from '@/components/ui/Section.astro';
import { STATS } from '@/data/stats';
---
<Section pad="md">
  <div
    data-reveal
    class="card-surface relative overflow-hidden rounded-[2rem] px-6 py-10 sm:px-12 sm:py-12"
  >
    <div
      class="halo pointer-events-none absolute -right-10 -top-10 size-48 rounded-full bg-sun/25"
      aria-hidden="true"
    >
    </div>
    <dl class="relative grid gap-8 text-center sm:grid-cols-3 sm:gap-6 sm:text-left">
      {
        STATS.map((s, i) => (
          <div class={i < STATS.length - 1 ? 'sm:border-r sm:border-navy/10 sm:pr-6' : ''}>
            <dt class="font-display text-3xl font-bold leading-none text-coral-deep sm:text-[2.4rem]">
              {s.countTo ? <span data-count-to={s.countTo}>0</span> : s.value}
            </dt>
            <dd class="mt-2 text-sm font-semibold leading-snug text-navy-soft">{s.label}</dd>
          </div>
        ))
      }
    </dl>
  </div>
</Section>
