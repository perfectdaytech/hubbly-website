---
// Inline SVG icon set — Lucide-style strokes, plus a few filled marks.
// Usage: <Icon name="check" class="size-5" />
interface Props {
  name: keyof typeof ICONS;
  size?: number;
  class?: string;
  strokeWidth?: number;
}

const ICONS = {
  check: { d: 'M20 6 9 17l-5-5' },
  'arrow-right': { d: 'M5 12h14 M13 5l7 7-7 7' },
  'arrow-up-right': { d: 'M7 7h10v10 M7 17 17 7' },
  'chevron-down': { d: 'm6 9 6 6 6-6' },
  menu: { d: 'M4 6h16 M4 12h16 M4 18h16' },
  x: { d: 'M18 6 6 18 M6 6l12 12' },
  sparkles: {
    d: 'M12 3l1.9 5.1L19 10l-5.1 1.9L12 17l-1.9-5.1L5 10l5.1-1.9z M19 15l.7 1.9 1.9.7-1.9.7-.7 1.9-.7-1.9-1.9-.7 1.9-.7z M5 4l.6 1.6L7 6.2l-1.6.6L5 8.4l-.6-1.6L3 6.2l1.6-.6z',
  },
  shield: {
    d: 'M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.5 3.8 17 5 19 5a1 1 0 0 1 1 1z M9.5 12l1.8 1.8L15 10',
  },
  heart: {
    d: 'M19 14c1.49-1.46 3-3.21 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.76 0-3 .5-4.5 2-1.5-1.5-2.74-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.3 1.5 4.05 3 5.5l7 7Z',
  },
  lock: { d: 'M7 11V7a5 5 0 0 1 10 0v4', rect: 'M5 11h14a2 2 0 0 1 2 2v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-7a2 2 0 0 1 2-2z' },
  sun: {
    d: 'M12 2v2 M12 20v2 M4.9 4.9l1.4 1.4 M17.7 17.7l1.4 1.4 M2 12h2 M20 12h2 M6.3 17.7l-1.4 1.4 M19.1 4.9l-1.4 1.4',
    circle: [12, 12, 4],
  },
  moon: { d: 'M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z' },
  bell: { d: 'M10.3 21a2 2 0 0 0 3.4 0 M5 9a7 7 0 0 1 14 0c0 5 2 6 2 7H3c0-1 2-2 2-7z' },
  'map-pin': { d: 'M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z', circle: [12, 10, 3] },
  calendar: { d: 'M8 2v4 M16 2v4 M3 10h18', rect: 'M5 4h14a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2z' },
  refresh: { d: 'M3 12a9 9 0 0 1 15-6.7L21 8 M21 3v5h-5 M21 12a9 9 0 0 1-15 6.7L3 16 M3 21v-5h5' },
  download: { d: 'M12 3v13 M7 11l5 5 5-5 M5 21h14' },
  star: { d: 'M11.5 3.3a.6.6 0 0 1 1 0l2.3 4.7 5.2.8a.6.6 0 0 1 .3 1l-3.7 3.6.9 5.2a.6.6 0 0 1-.9.6L12 18.5l-4.6 2.4a.6.6 0 0 1-.9-.6l.9-5.2-3.8-3.6a.6.6 0 0 1 .4-1l5.1-.8z', fill: true },
  play: { d: 'M8 5v14l11-7z', fill: true },
  'check-circle': { d: 'M9 12l2 2 4-4', circle: [12, 12, 9] },
} as const;

const { name, size = 24, class: cls = '', strokeWidth = 2 } = Astro.props;
const icon = ICONS[name];
const filled = 'fill' in icon && icon.fill;
const paths = (icon.d ?? '').split(' M').map((s, i) => (i === 0 ? s : 'M' + s)).filter(Boolean);
---
<svg
  xmlns="http://www.w3.org/2000/svg"
  viewBox="0 0 24 24"
  width={size}
  height={size}
  fill={filled ? 'currentColor' : 'none'}
  stroke={filled ? 'none' : 'currentColor'}
  stroke-width={strokeWidth}
  stroke-linecap="round"
  stroke-linejoin="round"
  class={cls}
  aria-hidden="true"
>
  {'rect' in icon && icon.rect && <path d={icon.rect} />}
  {'circle' in icon && icon.circle && (
    <circle cx={icon.circle[0]} cy={icon.circle[1]} r={icon.circle[2]} />
  )}
  {paths.map((d) => <path d={d} />)}
</svg>
