---
import Section from '@/components/ui/Section.astro';
import SectionHeading from '@/components/ui/SectionHeading.astro';
import Icon from '@/components/ui/Icon.astro';
import PricingCard from './PricingCard.astro';
import { MONTHLY_PLAN, FOUNDERS_LINE, PRICING_NOTE } from '@/data/pricing';
import { TRIAL_SHORT, WAITLIST_NO_PLACE } from '@/data/waitlist';

interface Props {
  /** Hide the section heading when the page already has its own. */
  withHeading?: boolean;
}
const { withHeading = true } = Astro.props;
---
<Section id="pricing" pad="lg" class="bg-gradient-to-b from-paper/50 to-cream">
  {
    withHeading && (
      <SectionHeading eyebrow="Simple, honest pricing">
        Free to try. <span class="text-gradient">Fair to keep.</span>
        <Fragment slot="lead">{TRIAL_SHORT}</Fragment>
      </SectionHeading>
    )
  }

  <div class={`mx-auto max-w-md ${withHeading ? 'mt-12' : 'mt-4'}`} data-reveal>
    <PricingCard plan={MONTHLY_PLAN} headingLevel={withHeading ? 'h3' : 'h2'} />
  </div>

  <p
    class="mx-auto mt-9 flex max-w-2xl items-start gap-2.5 rounded-2xl bg-sun/20 px-5 py-4 text-[0.95rem] font-semibold leading-relaxed text-navy ring-1 ring-sun/40"
    data-reveal
  >
    <Icon name="star" size={17} class="mt-0.5 shrink-0 text-coral-deep" />
    <span>
      {FOUNDERS_LINE} {WAITLIST_NO_PLACE}{' '}
      <a class="underline" href="/founders-terms">Founders' terms</a>.
    </span>
  </p>

  <p class="mx-auto mt-6 max-w-2xl text-center text-[0.82rem] leading-relaxed text-navy-soft">
    {PRICING_NOTE}
  </p>
</Section>
