{
  "name": "hubbly-website",
  "type": "module",
  "version": "1.0.0",
  "private": true,
  "description": "Marketing + legal website for Hubbly: a happy little home for your family's day.",
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "prebuild": "node scripts/generate-printables.mjs",
    "build": "astro check && astro build",
    "build:fast": "astro build",
    "preview": "astro preview",
    "test": "npm run build && node --test tests/*.test.mjs",
    "test:unit": "node --test tests/waitlist.test.mjs",
    "referrals:count": "node scripts/referral-count.mjs",
    "referrals:purge": "node scripts/purge-unconfirmed.mjs",
    "printables": "node scripts/generate-printables.mjs",
    "check:prepublish": "node scripts/prepublish-check.mjs",
    "astro": "astro"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.4",
    "@astrojs/mdx": "^4.3.0",
    "@astrojs/sitemap": "^3.4.0",
    "@fontsource-variable/fredoka": "^5.2.5",
    "@fontsource-variable/nunito": "^5.2.5",
    "@tailwindcss/vite": "^4.1.10",
    "astro": "^5.9.0",
    "posthog-js": "^1.386.6",
    "sharp": "^0.34.2",
    "tailwindcss": "^4.1.10",
    "typescript": "^5.8.3"
  },
  "overrides": {
    "@emnapi/core": "1.11.0",
    "@emnapi/runtime": "1.11.0",
    "@emnapi/wasi-threads": "1.2.2"
  }
}
