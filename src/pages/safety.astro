---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Section from '@/components/ui/Section.astro';
import SectionHeading from '@/components/ui/SectionHeading.astro';
import Eyebrow from '@/components/ui/Eyebrow.astro';
import Button from '@/components/ui/Button.astro';
import Icon from '@/components/ui/Icon.astro';
import { SAFETY_POINTS } from '@/data/safety';
import { CONTACT } from '@/data/site';
import { webPageSchema } from '@/lib/schema';

const pageDesc =
  'How Hubbly keeps your family safe: encryption, data minimisation, no ads, age-appropriate design and full control over your data.';

const childPledges = [
  { emoji: '🙅', title: 'No child accounts', text: 'Children never create logins, hand over emails, or have passwords. A parent sets everything up.' },
  { emoji: '📵', title: 'No profiling or ads', text: 'We never build advertising profiles of children, and there is no advertising anywhere in Hubbly.' },
  { emoji: '🧸', title: 'Age-appropriate by default', text: 'Designed to the UK Children’s Code: gentle, private settings on from the start, with nothing to tighten up.' },
  { emoji: '👪', title: 'Parents stay in charge', text: 'Grown-ups enter and control all family data. Settings sit behind a PIN kids can’t guess past.' },
];

const doList = [
  'Store your data on your device so it works offline',
  'Encrypt everything in transit and at rest',
  'Ask permission before notifications, photos or location',
  'Let you export or delete everything, anytime',
];
const neverList = [
  'Show adverts to anyone, on any plan',
  'Sell, rent or trade your family’s data',
  'Profile or track children for marketing',
  'Use your microphone or read your contacts',
];
---
<BaseLayout
  title="Safety & security"
  description={pageDesc}
  jsonLd={webPageSchema({ name: 'Safety & security', description: pageDesc, path: '/safety' })}
>
  <!-- header -->
  <header
    class="relative overflow-hidden bg-gradient-to-b from-paper to-cream pb-16 pt-[calc(var(--nav-h)+3.5rem)]"
  >
    <div class="halo absolute -right-24 -top-16 size-80 rounded-full bg-coral/22" aria-hidden="true"></div>
    <div class="halo absolute -left-24 bottom-0 size-72 rounded-full bg-mint/22" aria-hidden="true"></div>
    <div class="relative mx-auto w-full max-w-[1200px] px-5 sm:px-7 lg:px-8">
      <div class="max-w-2xl">
        <Eyebrow>
          <Icon name="shield" size={13} slot="icon" />
          Safety &amp; security
        </Eyebrow>
        <h1 class="mt-5 font-display text-4xl font-semibold leading-[1.08] tracking-tight text-navy sm:text-[3.1rem]">
          Built for the most precious data there is:
          <span class="text-gradient">your family's</span>
        </h1>
        <p class="mt-5 text-lg leading-relaxed text-navy-soft">
          Hubbly holds your children's routines, your calendar, your photos and
          your medication notes. We treat that the way you'd want us to: locked
          up, kept to ourselves, and never, ever sold.
        </p>
        <div class="mt-7 flex flex-wrap gap-3">
          <Button href="#report">Report a concern</Button>
          <Button href="/privacy" variant="white">Read the Privacy Policy</Button>
        </div>
      </div>
    </div>
  </header>

  <!-- trust pillars -->
  <Section pad="md">
    <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
      {
        SAFETY_POINTS.map((p, i) => (
          <div
            data-reveal
            style={`--reveal-delay:${i * 80}ms`}
            class="rounded-3xl bg-white p-6 shadow-card ring-1 ring-navy/[0.05]"
          >
            <span class="grid size-12 place-items-center rounded-2xl bg-coral/[0.1] text-2xl" aria-hidden="true">
              {p.emoji}
            </span>
            <h2 class="mt-3.5 font-display text-lg font-semibold text-navy">{p.title}</h2>
            <p class="mt-1.5 text-sm leading-relaxed text-navy-soft">{p.text}</p>
          </div>
        ))
      }
    </div>
  </Section>

  <!-- encryption -->
  <Section pad="md">
    <div class="grid items-center gap-12 lg:grid-cols-2 lg:gap-16">
      <div data-reveal>
        <SectionHeading eyebrow="Encryption" align="left" size="md">
          Locked, coming and going
          <Fragment slot="lead">
            Two layers of encryption, both handled for you, with nothing to switch on.
          </Fragment>
        </SectionHeading>
        <ul class="mt-7 space-y-4">
          <li class="flex gap-4">
            <span class="grid size-11 shrink-0 place-items-center rounded-2xl bg-sky/15 text-xl">🔐</span>
            <div>
              <h3 class="font-display text-base font-semibold text-navy">In transit</h3>
              <p class="mt-1 text-sm leading-relaxed text-navy-soft">
                Every byte between your devices and our servers travels over
                HTTPS / TLS, the standard encryption that protects data across
                the web.
              </p>
            </div>
          </li>
          <li class="flex gap-4">
            <span class="grid size-11 shrink-0 place-items-center rounded-2xl bg-mint/18 text-xl">🗄️</span>
            <div>
              <h3 class="font-display text-base font-semibold text-navy">At rest</h3>
              <p class="mt-1 text-sm leading-relaxed text-navy-soft">
                Synced data is stored in Google Cloud (Firebase), encrypted at
                rest with AES-256. On your device, data stays inside the app's
                private, OS-protected storage.
              </p>
            </div>
          </li>
        </ul>
      </div>
      <div data-reveal class="relative">
        <div class="halo absolute inset-6 rounded-full bg-sky/20" aria-hidden="true"></div>
        <div class="relative rounded-[2rem] bg-navy p-8 text-center shadow-lift sm:p-12">
          <div class="mx-auto grid size-24 place-items-center rounded-full bg-white/[0.06] ring-1 ring-white/10">
            <Icon name="lock" size={42} class="text-mint" />
          </div>
          <p class="mt-6 font-display text-xl font-semibold text-cream">
            Encrypted on the wire and on the disk
          </p>
          <p class="mt-2 text-sm leading-relaxed text-cream/65">
            We're honest about what this is and isn't: it's strong, industry-standard
            protection. We don't claim end-to-end encryption we haven't built.
          </p>
        </div>
      </div>
    </div>
  </Section>

  <!-- do / never -->
  <Section pad="md">
    <SectionHeading eyebrow="Data minimisation">
      We collect as little as we possibly can
      <Fragment slot="lead">
        The less we hold, the safer your family is. Here's the line we draw.
      </Fragment>
    </SectionHeading>
    <div class="mt-12 grid gap-6 md:grid-cols-2">
      <div data-reveal class="rounded-3xl bg-white p-7 shadow-card ring-1 ring-mint/30">
        <h3 class="flex items-center gap-2 font-display text-lg font-bold text-navy">
          <span class="grid size-8 place-items-center rounded-full bg-mint/25 text-base">✓</span>
          What Hubbly does
        </h3>
        <ul class="mt-4 space-y-3">
          {
            doList.map((d) => (
              <li class="flex items-start gap-2.5 text-[0.95rem] text-navy-soft">
                <Icon name="check" size={18} class="mt-0.5 shrink-0 text-mint" strokeWidth={3} />
                {d}
              </li>
            ))
          }
        </ul>
      </div>
      <div data-reveal style="--reveal-delay:90ms" class="rounded-3xl bg-white p-7 shadow-card ring-1 ring-coral/25">
        <h3 class="flex items-center gap-2 font-display text-lg font-bold text-navy">
          <span class="grid size-8 place-items-center rounded-full bg-coral/15 text-base">✕</span>
          What Hubbly never does
        </h3>
        <ul class="mt-4 space-y-3">
          {
            neverList.map((d) => (
              <li class="flex items-start gap-2.5 text-[0.95rem] text-navy-soft">
                <Icon name="x" size={18} class="mt-0.5 shrink-0 text-coral" strokeWidth={3} />
                {d}
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </Section>

  <!-- children -->
  <Section pad="md">
    <div
      data-reveal
      class="relative overflow-hidden rounded-[2.5rem] bg-gradient-to-br from-sky/20 via-mint/15 to-cream p-7 ring-1 ring-sky/25 sm:p-12"
    >
      <div class="halo absolute -right-16 -top-10 size-64 rounded-full bg-sun/25" aria-hidden="true"></div>
      <div class="relative max-w-2xl">
        <Eyebrow tone="sky">Designed for children</Eyebrow>
        <h2 class="mt-4 font-display text-3xl font-semibold tracking-tight text-navy sm:text-[2.4rem]">
          Hubbly is used <em class="not-italic text-coral-deep">by</em> children, so it's built around them
        </h2>
        <p class="mt-4 text-[1.05rem] leading-relaxed text-navy-soft">
          We follow the UK's Age-Appropriate Design Code (the Children's Code),
          and align with COPPA and GDPR-K. In plain terms: the safe choice is the
          default, and there's nothing for a child to accidentally switch off.
        </p>
      </div>
      <div class="relative mt-8 grid gap-4 sm:grid-cols-2">
        {
          childPledges.map((c) => (
            <div class="flex gap-3.5 rounded-2xl bg-white/70 p-4 ring-1 ring-white/80 backdrop-blur-sm">
              <span class="grid size-10 shrink-0 place-items-center rounded-xl bg-white text-xl shadow-soft">
                {c.emoji}
              </span>
              <div>
                <h3 class="font-display text-base font-semibold text-navy">{c.title}</h3>
                <p class="mt-0.5 text-sm leading-relaxed text-navy-soft">{c.text}</p>
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </Section>

  <!-- control -->
  <Section pad="md">
    <div class="grid gap-6 md:grid-cols-3">
      {
        [
          { emoji: '🔢', title: 'A PIN on the door', text: 'Settings sit behind a 4-digit PIN, so little hands can’t rewrite the rules or wander off into things they shouldn’t.' },
          { emoji: '🔑', title: 'Family-only by code', text: 'A device only joins your family with your 6-digit code. Codes are write-once and can never be re-pointed at someone else.' },
          { emoji: '🧳', title: 'Yours to take or erase', text: 'Export your whole hub to a file, leave your family to disconnect a device, or delete everything, all in a couple of taps.' },
        ].map((c, i) => (
          <div
            data-reveal
            style={`--reveal-delay:${i * 90}ms`}
            class="rounded-3xl bg-white p-7 shadow-card ring-1 ring-navy/[0.05]"
          >
            <span class="grid size-12 place-items-center rounded-2xl bg-lavender/20 text-2xl">{c.emoji}</span>
            <h3 class="mt-4 font-display text-lg font-semibold text-navy">{c.title}</h3>
            <p class="mt-1.5 text-sm leading-relaxed text-navy-soft">{c.text}</p>
          </div>
        ))
      }
    </div>
  </Section>

  <!-- report a concern -->
  <Section id="report" pad="md">
    <div
      data-reveal
      class="relative overflow-hidden rounded-[2.5rem] bg-navy px-6 py-12 text-center sm:px-12 sm:py-16"
    >
      <div class="halo absolute -left-10 -top-10 size-60 rounded-full bg-coral/30" aria-hidden="true"></div>
      <div class="relative mx-auto max-w-xl">
        <span class="grid mx-auto size-14 place-items-center rounded-2xl bg-white/[0.08] text-2xl">📨</span>
        <h2 class="mt-5 font-display text-2xl font-semibold text-cream sm:text-3xl">
          Spotted something? Tell us
        </h2>
        <p class="mt-3 leading-relaxed text-cream/70">
          If you have a safety, security or privacy concern about Hubbly, we want
          to hear it, and we'll reply personally. No bots, no ticket queue.
        </p>
        <Button href={`mailto:${CONTACT.safety}`} variant="primary" class="mt-6" external>
          <Icon name="heart" size={16} />
          {CONTACT.safety}
        </Button>
      </div>
    </div>
  </Section>
</BaseLayout>
