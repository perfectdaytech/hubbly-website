---
import Section from '@/components/ui/Section.astro';
import SectionHeading from '@/components/ui/SectionHeading.astro';
import Chip from '@/components/ui/Chip.astro';
import { SHOP_ITEMS, SHOP_FOOTNOTE } from '@/data/shop';

const ACCENT: Record<string, string> = {
  sun: 'bg-sun/25',
  lavender: 'bg-lavender/22',
};
---
<Section id="shop" pad="lg">
  <SectionHeading eyebrow="The shop">
    A little shop, <span class="text-gradient">on your terms</span>
    <Fragment slot="lead">
      Two kinds of entirely optional, cosmetic extras, coming after launch. They
      change how Hubbly looks and feels, never what it can do.
    </Fragment>
  </SectionHeading>

  <div class="mx-auto mt-12 grid max-w-4xl gap-6 md:grid-cols-2">
    {
      SHOP_ITEMS.map((item, i) => (
        <article
          data-reveal
          style={`--reveal-delay:${i * 110}ms`}
          class="flex flex-col rounded-3xl bg-white p-7 shadow-card ring-1 ring-navy/[0.05]"
        >
          <div class="flex items-start justify-between gap-3">
            <span
              class={`grid size-14 place-items-center rounded-2xl text-3xl ${ACCENT[item.accent]}`}
              aria-hidden="true"
            >
              {item.emoji}
            </span>
            <span class="inline-flex items-center gap-1.5 rounded-full bg-mint/25 px-3 py-1 text-[11px] font-extrabold uppercase tracking-wide text-[#1f6b54]">
              <span class="size-1.5 rounded-full bg-[#2c8068]" />
              Coming soon
            </span>
          </div>

          <h3 class="mt-4 font-display text-xl font-semibold text-navy">{item.name}</h3>
          <p class="mt-1 font-display text-lg font-bold text-coral-deep">
            {item.price} <span class="text-sm font-semibold text-navy-soft">each</span>
          </p>
          <p class="mt-2.5 text-[0.95rem] leading-relaxed text-navy-soft">{item.description}</p>

          <div class="mt-4 flex flex-wrap gap-2 border-t border-navy/[0.07] pt-4">
            {item.chips.map((c) => (
              <Chip>{c}</Chip>
            ))}
          </div>
        </article>
      ))
    }
  </div>

  <p class="mx-auto mt-9 max-w-xl text-center text-[0.97rem] italic leading-relaxed text-navy-soft">
    {SHOP_FOOTNOTE}
  </p>
</Section>
