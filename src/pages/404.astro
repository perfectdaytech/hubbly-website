---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Button from '@/components/ui/Button.astro';
import Icon from '@/components/ui/Icon.astro';

const links = [
  { label: 'Home', href: '/' },
  { label: 'Features', href: '/#features' },
  { label: 'Pricing', href: '/pricing' },
  { label: 'Safety', href: '/safety' },
  { label: 'FAQ', href: '/#faq' },
];
---
<BaseLayout
  title="Page not found"
  description="That page wandered off. Let's get you back to Hubbly."
  noindex
>
  <section
    class="relative flex min-h-[90vh] items-center justify-center overflow-hidden bg-gradient-to-b from-cream to-paper px-5 pt-[var(--nav-h)]"
  >
    <div class="halo absolute -left-24 top-1/4 size-80 rounded-full bg-mint/25" aria-hidden="true"></div>
    <div class="halo absolute -right-20 bottom-10 size-80 rounded-full bg-peach/30" aria-hidden="true"></div>
    <span class="absolute left-[18%] top-[22%] text-3xl text-navy/15 motion-safe:animate-bob" aria-hidden="true">?</span>
    <span class="absolute right-[20%] top-[30%] text-5xl text-navy/10 motion-safe:animate-twinkle" aria-hidden="true">?</span>
    <span class="absolute bottom-[24%] left-[26%] text-4xl text-navy/10 motion-safe:animate-drift" aria-hidden="true">?</span>

    <div class="relative max-w-xl text-center">
      <!-- confused Hubbly mark -->
      <div class="mx-auto w-36 motion-safe:animate-bob">
        <svg viewBox="0 0 64 64" class="w-full drop-shadow-[0_18px_30px_rgba(45,49,66,0.18)]" aria-hidden="true">
          <g fill="#88D9C0">
            <circle cx="46" cy="50" r="7"></circle>
            <circle cx="53" cy="51" r="5.5"></circle>
            <circle cx="50" cy="46" r="5"></circle>
          </g>
          <path d="M14 39.4l2 4 4.4.6-3.2 3 .8 4.4-3.9-2-3.9 2 .8-4.4-3.2-3 4.4-.6z" fill="#FFD166"></path>
          <rect x="18" y="30" width="28" height="22" rx="6" fill="#FBF0DA"></rect>
          <path d="M11.5 31.5 32 13l20.5 18.5a3 3 0 0 1-2 5.2H13.5a3 3 0 0 1-2-5.2Z" fill="#F4836F"></path>
          <rect x="39" y="17" width="5.2" height="9" rx="2" fill="#E9705E"></rect>
          <path d="M32 29.4c-2.4-2.6-5.6-1.2-5.6 1.4 0 2 2.2 3.6 5.6 6 3.4-2.4 5.6-4 5.6-6 0-2.6-3.2-4-5.6-1.4Z" fill="#FFF6E6"></path>
          <path d="M28 52v-6.5a4 4 0 0 1 8 0V52Z" fill="#F4836F"></path>
          <!-- confused face: one raised brow, dot eyes, wavy mouth -->
          <path d="M23.5 36.2c1-.9 2.4-1 3.4-.2" fill="none" stroke="#2D3142" stroke-width="1.5" stroke-linecap="round"></path>
          <circle cx="25.2" cy="39.6" r="1.7" fill="#2D3142"></circle>
          <circle cx="37.5" cy="39.5" r="1.7" fill="#2D3142"></circle>
          <path d="M29 44.6c1-1 2-1 3 0s2 1 3 0" fill="none" stroke="#2D3142" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"></path>
        </svg>
      </div>

      <p class="mt-6 font-display text-sm font-extrabold uppercase tracking-[0.2em] text-coral-deep">
        Error 404
      </p>
      <h1 class="mt-2 font-display text-4xl font-semibold tracking-tight text-navy sm:text-5xl">
        Hmm, this page wandered off
      </h1>
      <p class="mt-4 text-lg leading-relaxed text-navy-soft">
        Even the tidiest hub misplaces things now and then. Let's pop you back
        somewhere familiar.
      </p>

      <div class="mt-8 flex justify-center">
        <Button href="/" size="lg">
          <Icon name="arrow-right" size={18} class="rotate-180" />
          Take me home
        </Button>
      </div>

      <nav aria-label="Helpful links" class="mt-8">
        <ul class="flex flex-wrap justify-center gap-2">
          {
            links.map((l) => (
              <li>
                <a
                  href={l.href}
                  class="inline-block rounded-full bg-white px-4 py-2 text-sm font-semibold text-navy-soft shadow-soft ring-1 ring-navy/[0.06] transition hover:-translate-y-0.5 hover:text-navy hover:shadow-card"
                >
                  {l.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
    </div>
  </section>
</BaseLayout>
