---
import { getCollection, render } from 'astro:content';
import Section from '@/components/ui/Section.astro';
import SectionHeading from '@/components/ui/SectionHeading.astro';
import Chip from '@/components/ui/Chip.astro';

const entries = (await getCollection('features')).sort(
  (a, b) => a.data.order - b.data.order,
);
const features = await Promise.all(
  entries.map(async (e) => ({
    ...e.data,
    Content: (await render(e)).Content,
  })),
);

// Soft tint for each feature's icon chip, keyed off its brand colour.
const TINT: Record<string, string> = {
  coral: 'bg-coral/[0.13]',
  peach: 'bg-peach/25',
  sun: 'bg-sun/30',
  mint: 'bg-mint/25',
  sky: 'bg-sky/25',
  lavender: 'bg-lavender/25',
  navy: 'bg-navy/[0.07]',
};

// Static class names so Tailwind keeps them. Spans per row sum to 6,
// so the grid lands flush on desktop.
const SPAN: Record<number, string> = {
  2: 'lg:col-span-2',
  3: 'lg:col-span-3 sm:col-span-2',
  4: 'lg:col-span-4 sm:col-span-2',
};
---
<Section id="features" pad="lg" class="bg-gradient-to-b from-cream to-paper/60">
  <SectionHeading eyebrow="Everything in one hub">
    Fifteen features. <span class="text-gradient">One tidy screen.</span>
    <Fragment slot="lead">
      Right now, the calendar lives in one app, the to-do list in another, the
      chore chart on the fridge and the meal plan in someone's head. Hubbly
      brings it all together in one shared hub.
    </Fragment>
  </SectionHeading>

  <div class="mt-12 grid grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-6">
    {
      features.map((f, i) => (
        <article
          data-reveal
          style={`--reveal-delay:${(i % 3) * 70}ms`}
          class={`flex flex-col rounded-3xl p-6 transition-shadow hover:shadow-card ${
            f.dark
              ? 'bg-navy shadow-card'
              : 'bg-white shadow-soft ring-1 ring-navy/[0.05]'
          } ${SPAN[f.span] ?? 'lg:col-span-2'}`}
        >
          <div class="flex items-center gap-3">
            <span
              class={`grid size-11 shrink-0 place-items-center rounded-2xl text-xl ${
                f.dark ? 'bg-white/10' : (TINT[f.color] ?? TINT.navy)
              }`}
              aria-hidden="true"
            >
              {f.icon}
            </span>
            <h3 class={`font-display text-xl font-semibold ${f.dark ? 'text-cream' : 'text-navy'}`}>
              {f.title}
            </h3>
          </div>

          <div
            class={`mt-3.5 text-[0.95rem] leading-relaxed ${
              f.dark ? 'text-cream/80' : 'text-navy-soft'
            } [&_p]:m-0 [&_em]:not-italic [&_em]:font-semibold`}
          >
            <f.Content />
          </div>

          {f.chips.length > 0 && (
            <div class="mt-auto flex flex-wrap gap-2 pt-4">
              {f.chips.map((c) => (
                <Chip tone={f.dark ? 'dark' : 'light'}>{c}</Chip>
              ))}
            </div>
          )}
        </article>
      ))
    }

    <!-- full-width hint that the app keeps growing, free -->
    <article
      data-reveal
      class="flex flex-col items-center justify-center gap-1.5 rounded-3xl border-2 border-dashed border-coral/30 bg-coral/[0.04] px-6 py-7 text-center sm:col-span-2 lg:col-span-6"
    >
      <p class="font-display text-lg font-semibold text-navy">
        <span aria-hidden="true">✨</span> And more on the way
      </p>
      <p class="text-[0.95rem] font-medium text-navy-soft">
        Every feature included from day one, nothing locked behind a paywall,
        and every update included in your subscription.
      </p>
    </article>
  </div>
</Section>
