---
import Section from '@/components/ui/Section.astro';
import Eyebrow from '@/components/ui/Eyebrow.astro';
import Button from '@/components/ui/Button.astro';
import Icon from '@/components/ui/Icon.astro';
import { SAFETY_POINTS } from '@/data/safety';
---
<Section id="safety-promise" pad="md">
  <div
    class="relative overflow-hidden rounded-[2.5rem] bg-navy px-6 py-14 sm:px-12 sm:py-16 lg:px-16"
  >
    <!-- coral glow -->
    <div
      class="halo pointer-events-none absolute -left-16 -top-16 size-72 rounded-full bg-coral/35"
      aria-hidden="true"
    >
    </div>
    <div
      class="halo pointer-events-none absolute -bottom-24 right-0 size-80 rounded-full bg-coral/20"
      aria-hidden="true"
    >
    </div>
    <div
      class="pointer-events-none absolute right-10 top-10 motion-safe:animate-twinkle"
      aria-hidden="true"
    >
      <Icon name="star" size={20} class="text-night-star/50" />
    </div>

    <div class="relative grid gap-12 lg:grid-cols-[1fr_1.15fr] lg:items-center">
      <!-- intro -->
      <div data-reveal>
        <Eyebrow tone="cream">
          <Icon name="shield" size={13} slot="icon" />
          Safe by design
        </Eyebrow>
        <h2 class="mt-5 font-display text-3xl font-semibold leading-tight text-cream sm:text-[2.6rem]">
          Your family's life is
          <span class="text-coral">nobody's business</span> but yours
        </h2>
        <p class="mt-4 text-[1.05rem] leading-relaxed text-cream/70">
          Hubbly holds your children's routines, photos and reminders. No ads,
          no profiling, no selling. Just a quiet, well-locked hub.
        </p>
        <Button href="/privacy" variant="primary" class="mt-7">
          Read our Privacy Policy
          <Icon name="arrow-right" size={17} class="transition-transform duration-200 group-hover/btn:translate-x-0.5" />
        </Button>
      </div>

      <!-- points -->
      <div class="grid gap-4 sm:grid-cols-2">
        {
          SAFETY_POINTS.map((p, i) => (
            <div
              data-reveal
              style={`--reveal-delay:${i * 90}ms`}
              class="rounded-2xl bg-white/[0.06] p-5 ring-1 ring-white/[0.08] transition-colors duration-300 hover:bg-white/[0.1]"
            >
              <span class="grid size-11 place-items-center rounded-xl bg-white/10 text-xl" aria-hidden="true">
                {p.emoji}
              </span>
              <h3 class="mt-3 font-display text-base font-semibold text-cream">{p.title}</h3>
              <p class="mt-1 text-sm leading-relaxed text-cream/65">{p.text}</p>
            </div>
          ))
        }
      </div>
    </div>
  </div>
</Section>
