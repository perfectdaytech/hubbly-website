---
// "Your devices, your way" — the cross-platform / BYOD message.
// Absorbs the kitchen-counter pitch (kitchen mode + glanceable design)
// so we no longer ship a separate KitchenShowcase section saying the
// same thing twice.
import Section from '@/components/ui/Section.astro';
import SectionHeading from '@/components/ui/SectionHeading.astro';
import Icon from '@/components/ui/Icon.astro';

const points = [
  {
    emoji: '🤝',
    title: 'Android, Apple, anything in the drawer',
    text: "iPhone, Pixel, an old iPad, a £40 Fire tablet. Hubbly runs natively on both platforms, on whatever your family already owns. No new hardware, no Hubbly-specific tablet to buy.",
  },
  {
    emoji: '🛒',
    title: 'Live on every screen at once',
    text: "Plan tomorrow on the kitchen tablet, tick chores off on your phone, add a forgotten egg to the shopping list while you're already in the shop. It pops up for whoever is nearest the trolley.",
  },
  {
    emoji: '🍳',
    title: 'Kitchen-ready, glanceable across the room',
    text: "Switch on Kitchen mode and any spare tablet keeps the screen awake, drifts into a photo screensaver when it's quiet, and reads at a glance from across the kitchen.",
  },
  {
    emoji: '✉️',
    title: 'Email is optional, just a safety net',
    text: "No sign-up forms. Add one email if you want, a quiet recovery key in case every device ever gets wiped at once. Otherwise, no email needed.",
  },
];

// Device-row palette. Each device renders as an inline SVG with a navy
// frame and a tinted "screen" so they read clearly at small sizes.
interface Device {
  label: string;
  kind: 'phone' | 'tablet';
  /** Notch / camera treatment, picked so each of the four reads as itself. */
  variant: 'androidPhone' | 'iPhone' | 'iPad' | 'fire';
  /** Screen tint hex. */
  screen: string;
  /** Ring tint applied to the card background. */
  halo: string;
}
const devices: Device[] = [
  { label: 'Android phone', kind: 'phone', variant: 'androidPhone', screen: '#A8E6D2', halo: 'bg-mint/20' },
  { label: 'iPad', kind: 'tablet', variant: 'iPad', screen: '#BFE4F1', halo: 'bg-sky/20' },
  { label: 'Fire tablet', kind: 'tablet', variant: 'fire', screen: '#FFD2B5', halo: 'bg-peach/25' },
  { label: 'iPhone', kind: 'phone', variant: 'iPhone', screen: '#DCC8FF', halo: 'bg-lavender/25' },
];

const FRAME = '#2D3142';
const SCREEN_DOT = '#2D3142';
const ACCENT = '#FF6B6B';
---
<Section id="devices" pad="lg">
  <SectionHeading eyebrow="Your devices, your way">
    Bring the screens you <span class="text-gradient">already have</span>
    <Fragment slot="lead">
      Hubbly runs on whatever your family already owns. Android and Apple,
      phone and tablet, all on the same family hub.
    </Fragment>
  </SectionHeading>

  <!-- Device row. Icons + sync arrows live on one flex line (centre-aligned
       so the arrows sit between the icons, not below them). Labels are
       absolutely positioned beneath each icon so they don't pull the
       column taller and shift the arrows downward. The mb-10 keeps the
       labels from colliding with the strap-line below. -->
  <div
    data-reveal
    class="relative mx-auto mt-12 mb-10 flex max-w-3xl items-center justify-center gap-3 sm:gap-6"
  >
    <div
      class="halo pointer-events-none absolute left-1/2 top-1/2 size-72 -translate-x-1/2 -translate-y-1/2 rounded-full bg-sun/15"
      aria-hidden="true"
    >
    </div>
    {
      devices.map((d, i) => (
        <>
          <div class="relative">
            <div
              class={`relative grid place-items-center rounded-3xl p-3 sm:p-4 ${d.halo}`}
              aria-hidden="true"
            >
              {d.kind === 'phone' ? (
                <svg
                  viewBox="0 0 40 64"
                  class="h-16 w-auto sm:h-20"
                  xmlns="http://www.w3.org/2000/svg"
                >
                  {/* body */}
                  <rect x="1" y="1" width="38" height="62" rx="7" fill={FRAME} />
                  {/* screen */}
                  <rect x="3" y="4" width="34" height="56" rx="4" fill={d.screen} />
                  {/* notch / camera */}
                  {d.variant === 'iPhone' && (
                    <rect x="14" y="6" width="12" height="3" rx="1.5" fill={FRAME} />
                  )}
                  {d.variant === 'androidPhone' && (
                    <circle cx="20" cy="7.5" r="1.4" fill={SCREEN_DOT} />
                  )}
                  {/* dashboard hint */}
                  <rect x="6" y="14" width="14" height="2.2" rx="1.1" fill={ACCENT} opacity="0.85" />
                  <rect x="6" y="20" width="28" height="6" rx="2" fill="#FFFFFF" opacity="0.85" />
                  <rect x="6" y="29" width="28" height="6" rx="2" fill="#FFFFFF" opacity="0.65" />
                  <rect x="6" y="38" width="28" height="6" rx="2" fill="#FFFFFF" opacity="0.5" />
                  <circle cx="11" cy="51" r="2.5" fill="#FFD166" />
                  <rect x="16" y="49" width="18" height="2" rx="1" fill="#FFFFFF" opacity="0.7" />
                  <rect x="16" y="53" width="12" height="1.5" rx="0.75" fill="#FFFFFF" opacity="0.55" />
                  {/* home indicator */}
                  <rect x="14" y="60" width="12" height="1" rx="0.5" fill={FRAME} opacity="0.4" />
                </svg>
              ) : (
                <svg
                  viewBox="0 0 56 44"
                  class="h-16 w-auto sm:h-20"
                  xmlns="http://www.w3.org/2000/svg"
                >
                  {/* body */}
                  <rect x="1" y="1" width="54" height="42" rx="4.5" fill={FRAME} />
                  {/* screen */}
                  <rect x="3.5" y="4" width="49" height="36" rx="2.5" fill={d.screen} />
                  {/* camera dot — iPad: top-centre; Fire: side-centre (landscape default) */}
                  {d.variant === 'iPad' && (
                    <circle cx="28" cy="6.2" r="0.9" fill={SCREEN_DOT} />
                  )}
                  {d.variant === 'fire' && (
                    <circle cx="5" cy="22" r="0.9" fill={SCREEN_DOT} />
                  )}
                  {/* dashboard hint */}
                  <rect x="6" y="9" width="14" height="2.2" rx="1.1" fill={ACCENT} opacity="0.85" />
                  <rect x="6" y="14" width="44" height="5" rx="1.5" fill="#FFFFFF" opacity="0.85" />
                  <rect x="6" y="22" width="20" height="5" rx="1.5" fill="#FFFFFF" opacity="0.7" />
                  <rect x="29" y="22" width="20" height="5" rx="1.5" fill="#FFFFFF" opacity="0.7" />
                  <circle cx="9" cy="33" r="2" fill="#FFD166" />
                  <rect x="13" y="31.5" width="14" height="2" rx="1" fill="#FFFFFF" opacity="0.7" />
                  <rect x="13" y="34.5" width="10" height="1.5" rx="0.75" fill="#FFFFFF" opacity="0.55" />
                  <rect x="30" y="31" width="20" height="5" rx="1.5" fill="#FFFFFF" opacity="0.55" />
                </svg>
              )}
            </div>
            <span class="absolute left-1/2 top-full mt-2 -translate-x-1/2 whitespace-nowrap text-[11px] font-bold uppercase tracking-wide text-navy-soft sm:text-xs">
              {d.label}
            </span>
          </div>
          {i < devices.length - 1 && (
            <div class="relative flex flex-1 items-center justify-center" aria-hidden="true">
              <div class="h-px w-full bg-gradient-to-r from-coral/0 via-coral/50 to-coral/0" />
              <div class="absolute grid size-6 place-items-center rounded-full bg-cream text-coral shadow-soft ring-1 ring-coral/30">
                <Icon name="refresh" size={12} />
              </div>
            </div>
          )}
        </>
      ))
    }
  </div>

  <!-- Four supporting points: 2x2 grid -->
  <ul class="mt-10 grid gap-5 sm:grid-cols-2">
    {
      points.map((p, i) => (
        <li
          data-reveal
          style={`--reveal-delay:${i * 70}ms`}
          class="card-surface flex items-start gap-4 rounded-[1.5rem] p-6"
        >
          <span class="grid size-12 shrink-0 place-items-center rounded-2xl bg-white text-2xl shadow-soft ring-1 ring-navy/[0.06]">
            {p.emoji}
          </span>
          <div>
            <h3 class="font-display text-lg font-semibold text-navy">{p.title}</h3>
            <p class="mt-1.5 text-[0.97rem] leading-relaxed text-navy-soft">{p.text}</p>
          </div>
        </li>
      ))
    }
  </ul>
</Section>
