---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Section from '@/components/ui/Section.astro';
import { CONFIRM_BODY, CONFIRM_SUBJECT, WAITLIST_MOCK } from '@/data/waitlist';
---
<BaseLayout
  title="You're nearly on the list"
  description="Check your email and confirm you want Hubbly emails. If you didn't sign up, we'll delete your address within 14 days."
  noindex={true}
>
  <Section pad="lg" innerClass="pt-[calc(var(--nav-h)+3rem)] max-w-2xl">
    <h1 class="font-display text-4xl font-semibold tracking-tight text-navy sm:text-5xl">You're nearly on the list</h1>
    <p class="mt-5 text-lg leading-relaxed text-navy-soft">
      We've asked our email provider to send a confirmation. The subject is "{CONFIRM_SUBJECT}".
    </p>
    <p class="mt-4 text-lg font-semibold leading-relaxed text-navy">{CONFIRM_BODY}</p>
    <p class="mt-4 text-base leading-relaxed text-navy-soft">
      Unconfirmed sign-ups are deleted after 14 days. You aren't on the list, and a referral doesn't count, until you confirm.
    </p>
    {
      WAITLIST_MOCK && (
        <p class="mt-6 rounded-2xl bg-sun/30 px-5 py-4 text-base leading-relaxed text-navy">
          Preview mode: no email was sent and nothing was saved.
          <a class="font-semibold text-coral-deep underline" href="/confirmed?code=H7K2MNPQ">Preview the confirmed page</a>.
        </p>
      )
    }
  </Section>
</BaseLayout>
